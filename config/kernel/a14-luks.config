# Merged on top of arm64 defconfig + qcom-deb-images kernel-configs/*.config.
# Neither enables dm-crypt; a LUKS root fails with "crypt: unknown target type".
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m
# Kernel crypto user-space interfaces used by cryptsetup (benchmark, some ciphers/KDFs).
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_AEAD=m
CONFIG_CRYPTO_ESSIV=m
