From 5a9c41912a7b7b365247df8c0cdddb113e330f48 Mon Sep 17 00:00:00 2001
From: Tyler Baker <forcedinductionz@gmail.com>
Date: Sun, 27 Sep 2026 02:55:54 -0400
Subject: [PATCH 07/12] drm/msm/dp: keep eDP at its native lane count after an
 EQ failure

When channel equalization fails with clock recovery intact,
msm_dp_ctrl_on_link() halves the lane count and retries. An eDP panel
runs its mode on its native lanes, and the mode is not revalidated
against the reduced bandwidth, so a transient EQ failure on a DPMS wake
leaves the panel dark:

  [drm:msm_dp_ctrl_link_train_1_2 [msm]] *ERROR* link training #2 on phy 0 failed. ret=-110
  [drm:msm_dp_ctrl_link_train [msm]] *ERROR* link training on sink failed. ret=-110

Pass is_edp to the controller and, on eDP, retry at the same lane count
and rate; a clock recovery failure still lowers the rate.

Signed-off-by: Tyler Baker <forcedinductionz@gmail.com>
Link: https://github.com/EmbeddedAndroid/linux/commit/2de6ab547df0f88dc88e3632d139b1e98b39ad05
---
 drivers/gpu/drm/msm/dp/dp_ctrl.c    | 12 +++++++++++-
 drivers/gpu/drm/msm/dp/dp_ctrl.h    |  3 ++-
 drivers/gpu/drm/msm/dp/dp_display.c |  3 ++-
 3 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index 3dbcf8474..2188b0314 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -142,6 +142,8 @@ struct msm_dp_ctrl_private {
 	bool core_clks_on;
 	bool link_clks_on;
 	bool stream_clks_on[DP_STREAM_MAX];
+
+	bool is_edp;
 };
 
 static inline u32 msm_dp_read_ahb(const struct msm_dp_ctrl_private *ctrl, u32 offset)
@@ -2486,9 +2488,15 @@ int msm_dp_ctrl_on_link(struct msm_dp_ctrl *msm_dp_ctrl,
 
 			drm_dp_dpcd_read_link_status(ctrl->aux, link_status);
 
+			/*
+			 * An eDP panel is driven at its native lane count; fewer
+			 * lanes cannot carry its mode, so retry equalization as is.
+			 */
 			if (!drm_dp_clock_recovery_ok(link_status,
 					ctrl->link->link_params.num_lanes))
 				rc = msm_dp_ctrl_link_rate_down_shift(ctrl);
+			else if (ctrl->is_edp)
+				rc = 0;
 			else
 				rc = msm_dp_ctrl_link_lane_down_shift(ctrl, panel);
 
@@ -2866,7 +2874,8 @@ struct msm_dp_ctrl *msm_dp_ctrl_get(struct device *dev, struct msm_dp_link *link
 			void __iomem *ahb_base,
 			void __iomem *link_base,
 			void __iomem *mst2link_base,
-			void __iomem *mst3link_base)
+			void __iomem *mst3link_base,
+			bool is_edp)
 {
 	struct msm_dp_ctrl_private *ctrl;
 	int ret;
@@ -2907,6 +2916,7 @@ struct msm_dp_ctrl *msm_dp_ctrl_get(struct device *dev, struct msm_dp_link *link
 	ctrl->link_base = link_base;
 	ctrl->mst2link_base = mst2link_base;
 	ctrl->mst3link_base = mst3link_base;
+	ctrl->is_edp = is_edp;
 
 	ret = msm_dp_ctrl_clk_init(&ctrl->msm_dp_ctrl);
 	if (ret) {
diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.h b/drivers/gpu/drm/msm/dp/dp_ctrl.h
index 80d925850..b7e6a449a 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.h
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.h
@@ -37,7 +37,8 @@ struct msm_dp_ctrl *msm_dp_ctrl_get(struct device *dev,
 				    void __iomem *ahb_base,
 				    void __iomem *link_base,
 				    void __iomem *mst2link_base,
-				    void __iomem *mst3link_base);
+				    void __iomem *mst3link_base,
+				    bool is_edp);
 
 void msm_dp_ctrl_reset(struct msm_dp_ctrl *msm_dp_ctrl,
 		       struct msm_dp_panel *panel);
diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index 30d152146..f030a91ff 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -583,7 +583,8 @@ static int msm_dp_init_sub_modules(struct msm_dp_display_private *dp)
 
 	dp->ctrl = msm_dp_ctrl_get(dev, dp->link, dp->aux,
 			       phy, dp->ahb_base, dp->link_base,
-			       dp->mst2link_base, dp->mst3link_base);
+			       dp->mst2link_base, dp->mst3link_base,
+			       dp->msm_dp_display.is_edp);
 	if (IS_ERR(dp->ctrl)) {
 		rc = PTR_ERR(dp->ctrl);
 		DRM_ERROR("failed to initialize ctrl, rc = %d\n", rc);
-- 
